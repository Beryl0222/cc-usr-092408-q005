{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "国家教材版本接续领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "EDITION_REGISTERED",
        "EDITION_RELEASED",
        "EDITION_RETIRED",
        "PRINT_BATCH_REGISTERED",
        "UNIT_REGISTERED",
        "LAW_REGISTERED",
        "LAW_BASIS_ATTACHED",
        "SCHOOL_REGISTERED",
        "ADOPTION_STARTED",
        "ADOPTION_SWITCHED",
        "ISSUE_REPORTED",
        "CORRECTION_DECIDED",
        "CORRECTION_INCLUDED",
        "FREEZE_IMPOSED",
        "FREEZE_ACK_LAYER",
        "DECISION_REVIEW_PENDING",
        "CONTENT_TAUGHT",
        "PREP_REFERENCED",
        "NOTICE_ACKNOWLEDGED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "textbook_edition",
        "content_unit",
        "regulation",
        "correction_notice",
        "course_adoption",
        "freeze_acknowledgement",
        "school",
        "teaching_record",
        "teacher_prep_reference"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
