{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "国家教材版本接续领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "EDITION_RELEASED",
        "CONTENT_UNIT_REGISTERED",
        "CONTENT_REFERENCE_RECORDED",
        "LEGAL_BASIS_REGISTERED",
        "ADOPTION_RECORDED",
        "ADOPTION_SWITCH_REQUESTED",
        "ADOPTION_SWITCHED",
        "ISSUE_REPORTED",
        "CORRECTION_APPROVED",
        "ADOPTION_FROZEN",
        "NOTICE_ACKNOWLEDGED",
        "TEACHING_FACT_RECORDED",
        "REMINDER_SCHEDULED",
        "REMINDER_DELIVERED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "textbook_edition",
        "content_unit",
        "correction_notice",
        "course_adoption",
        "legal_basis",
        "textbook_issue",
        "reminder",
        "teaching_fact"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
